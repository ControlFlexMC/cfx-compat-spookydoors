{
  "mod_id": "spookydoors",
  "mod_name": "Spooky Doors",
  "home_page": "https://www.curseforge.com/minecraft/mc-mods/spooky-doors",
  "contributors": [
    "ifels"
  ],
  "dependencies": [
    {
      "mod_id": "cfx_compat_spookydoors",
      "mod_name": "Control Flex x Spooky Doors"
    }
  ],
  "config_version": "1.0.0",
  "mod_versions": [
    {
      "version": "",
      "inGameKeys": {},
      "screenKeys": {},
      "overlayKeys": {},
      "aiming": [
        {
          "targets": [
            "block:*:*_door"
          ],
          "overrideActions": [
            "cfx_compat_spookydoors:grab",
            "cfx_compat_spookydoors:push",
            "cfx_compat_spookydoors:pull"
          ],
          "defaults": {
            "main": {
              "cfx_compat_spookydoors:grab": "leftStickClick|HOLD",
              "cfx_compat_spookydoors:push": "leftStickUp|HOLD",
              "cfx_compat_spookydoors:pull": "leftStickDown|HOLD"
            }
          }
        }
      ]
    }
  ]
}
